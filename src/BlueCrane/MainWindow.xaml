<Window x:Class="BlueCrane.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:BlueCrane.Shell"
        Title="Blue Crane Browser"
        Width="1280" Height="820"
        MinWidth="520" MinHeight="380"
        Background="{StaticResource Brush.Chrome}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        FontFamily="{StaticResource Font.Sans}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="8"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            NonClientFrameEdges="None"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />  <!-- tab strip, doubles as the drag caption -->
            <RowDefinition Height="52" />  <!-- address band -->
            <RowDefinition Height="*" />   <!-- page -->
        </Grid.RowDefinitions>

        <!-- ══════════════════ Tab strip ══════════════════ -->
        <Grid Grid.Row="0" x:Name="TabRow">
            <Grid.ColumnDefinitions>
                <!-- Auto, capped: the strip stops at its own content so the new-tab
                     button sits beside the last tab instead of at the window edge. -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ItemsControl Grid.Column="0"
                          x:Name="TabStrip"
                          ItemsSource="{Binding Tabs}"
                          Margin="0,4,0,0"
                          MaxWidth="{Binding ActualWidth, ElementName=TabRow,
                                             Converter={StaticResource Subtract}, ConverterParameter=200}"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:TabStripPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Root"
                                Style="{StaticResource Style.TabRoot}"
                                MouseLeftButtonDown="Tab_MouseDown"
                                MouseDown="Tab_MiddleClick"
                                ToolTip="{Binding Title}">
                            <Border.Background>
                                <SolidColorBrush Color="Transparent" />
                            </Border.Background>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Favicon, or a dot when the tab holds no renderer -->
                                <Grid Grid.Column="0" Width="16" Height="16" Margin="0,0,10,0">
                                    <Image x:Name="Fav" Source="{Binding Favicon}"
                                           Width="16" Height="16"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Rectangle x:Name="Dot" Width="6" Height="6"
                                               Fill="{StaticResource Brush.Slate}"
                                               Visibility="Collapsed" />
                                </Grid>

                                <TextBlock x:Name="Label"
                                           Grid.Column="1"
                                           Text="{Binding Title}"
                                           Foreground="{StaticResource Brush.Mute}"
                                           FontSize="{StaticResource Font.Size.Body}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />

                                <Button Grid.Column="2"
                                        Style="{StaticResource Style.TabClose}"
                                        Click="TabClose_Click"
                                        ToolTip="Close tab">
                                    <Path Style="{StaticResource Style.Glyph}"
                                          Data="{StaticResource Icon.Close}"
                                          Width="11" Height="11" />
                                </Button>
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <!-- The active tab lifts to the signature navy. -->
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Root" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource Color.Navy}" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Brush.Ink}" />
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Accent}" />
                            </DataTrigger>

                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsActive}" Value="False" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource Color.Surface}" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Brush.Body}" />
                            </MultiDataTrigger>

                            <!-- A sleeping tab reads as present but quiet. -->
                            <DataTrigger Binding="{Binding IsDormant}" Value="True">
                                <Setter TargetName="Label" Property="Opacity" Value="0.55" />
                                <Setter TargetName="Fav" Property="Opacity" Value="0.4" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                <Setter TargetName="Fav" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Grid.Column="1"
                    x:Name="NewTabButton"
                    Style="{StaticResource Style.IconButton}"
                    Click="NewTab_Click"
                    HorizontalAlignment="Left"
                    Margin="4,4,0,0"
                    ToolTip="New tab  (Ctrl+T)"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Path Style="{StaticResource Style.Glyph}" Data="{StaticResource Icon.Plus}" />
            </Button>

            <StackPanel Grid.Column="2" x:Name="CaptionBar" Orientation="Horizontal"
                        VerticalAlignment="Top"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource Style.CaptionButton}" Click="Minimize_Click" ToolTip="Minimise">
                    <Path Style="{StaticResource Style.Glyph}" Data="{StaticResource Icon.Minimize}" />
                </Button>
                <Button x:Name="MaxButton" Style="{StaticResource Style.CaptionButton}" Click="Maximize_Click" ToolTip="Maximise">
                    <Path x:Name="MaxGlyph" Style="{StaticResource Style.Glyph}" Data="{StaticResource Icon.Maximize}" />
                </Button>
                <Button Style="{StaticResource Style.CaptionButton}" Click="Close_Click" ToolTip="Close">
                    <Path Style="{StaticResource Style.Glyph}" Data="{StaticResource Icon.Close}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ══════════════════ Address band ══════════════════
             One square rectangle spanning the full width. The navigation controls and
             the footprint readout sit inside it rather than beside it, so the address
             bar reads as a single edge-to-edge surface. -->
        <Border Grid.Row="1" Style="{StaticResource Style.AddressBand}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="6,0,0,0">
                    <Button x:Name="BackButton" Style="{StaticResource Style.IconButton}"
                            Click="Back_Click" ToolTip="Back  (Alt+←)">
                        <Path Style="{StaticResource Style.Glyph}" Data="{StaticResource Icon.Back}" />
                    </Button>
                    <Button x:Name="ForwardButton" Style="{StaticResource Style.IconButton}"
                            Click="Forward_Click" ToolTip="Forward  (Alt+→)">
                        <Path Style="{StaticResource Style.Glyph}" Data="{StaticResource Icon.Forward}" />
                    </Button>
                    <Button x:Name="ReloadButton" Style="{StaticResource Style.IconButton}"
                            Click="Reload_Click" ToolTip="Reload  (Ctrl+R)">
                        <Path x:Name="ReloadGlyph" Style="{StaticResource Style.Glyph}" Data="{StaticResource Icon.Reload}" />
                    </Button>
                </StackPanel>

                <TextBox Grid.Column="1"
                         x:Name="AddressBar"
                         Style="{StaticResource Style.Omnibox}"
                         VerticalAlignment="Stretch"
                         KeyDown="AddressBar_KeyDown"
                         GotKeyboardFocus="AddressBar_GotFocus"
                         LostKeyboardFocus="AddressBar_LostFocus" />

                <!-- Live footprint. The number is the whole point of the browser, so it
                     sits on the toolbar rather than buried in a menu. -->
                <Border Grid.Column="2" x:Name="FootprintChip"
                        VerticalAlignment="Center" Margin="0,0,12,0"
                        Background="{StaticResource Brush.Chrome}"
                        BorderBrush="{StaticResource Brush.Hairline}"
                        BorderThickness="1"
                        Padding="12,6"
                        ToolTip="{Binding FootprintDetail}">
                    <TextBlock x:Name="FootprintText"
                               Text="{Binding FootprintLabel}"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="{StaticResource Font.Size.Caption}"
                               Foreground="{StaticResource Brush.Mute}" />
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════ Page ══════════════════
             Every live tab's WebView2 lives here; only the active one is visible. -->
        <Grid Grid.Row="2" x:Name="ViewHost" Background="{StaticResource Brush.Canvas}" />
    </Grid>
</Window>
