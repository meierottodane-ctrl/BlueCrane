<!--
    Stroke-drawn glyphs on a 16×16 grid. Vector, not font-based: no icon font to load,
    no image assets to decode, and they stay crisp at every DPI.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Geometry x:Key="Icon.Back">M10.5,3.5 L5.5,8 L10.5,12.5</Geometry>
    <Geometry x:Key="Icon.Forward">M5.5,3.5 L10.5,8 L5.5,12.5</Geometry>
    <Geometry x:Key="Icon.Reload">M13,8 A5,5 0 1,1 11.2,4.2 M13.4,2 L13.4,5.2 L10.2,5.2</Geometry>
    <Geometry x:Key="Icon.Close">M4.5,4.5 L11.5,11.5 M11.5,4.5 L4.5,11.5</Geometry>
    <Geometry x:Key="Icon.Plus">M8,4 L8,12 M4,8 L12,8</Geometry>
    <Geometry x:Key="Icon.Minimize">M4,8 L12,8</Geometry>
    <Geometry x:Key="Icon.Maximize">M4,4 L12,4 L12,12 L4,12 Z</Geometry>
    <Geometry x:Key="Icon.Restore">M4,6 L10,6 L10,12 L4,12 Z M6,6 L6,4 L12,4 L12,10 L10,10</Geometry>
    <Geometry x:Key="Icon.Globe">M8,2 A6,6 0 1,1 7.99,2 M2,8 L14,8 M8,2 C5.5,4.5 5.5,11.5 8,14 M8,2 C10.5,4.5 10.5,11.5 8,14</Geometry>

    <!-- Base style for every glyph. Consumers set only Data and Foreground. -->
    <Style x:Key="Style.Glyph" TargetType="Path">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="StrokeThickness" Value="1.3" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="None" />
    </Style>

</ResourceDictionary>
