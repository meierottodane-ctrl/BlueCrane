<!--
    Design tokens — "Crane Browser Design System".
    Single source of truth for colour, type, radius, spacing and motion.
    Nothing downstream should hard-code a literal; add a token here instead.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ─────────────── Palette ───────────────
         The five brand neutrals, verbatim from the design system. -->
    <Color x:Key="Color.NavyDeep">#081528</Color>
    <Color x:Key="Color.Navy">#0B1D36</Color>
    <Color x:Key="Color.Slate">#44556A</Color>
    <Color x:Key="Color.Silver">#DCE4ED</Color>
    <Color x:Key="Color.White">#FFFFFF</Color>
    <Color x:Key="Color.Sky">#A9CDED</Color>

    <!-- Derived tones the system implies but does not name. They form one value ladder
         climbing away from the canvas, which is what separates surfaces in a system
         with no rounded corners and no heavy borders to lean on:
           NavyDeep  chrome behind the tabs
           Navy      page canvas and the active tab
           Surface   hover on the deep chrome
           Raised    input surfaces — the address band and the search field
           Hover     hover on a raised surface -->
    <Color x:Key="Color.Surface">#14293F</Color>
    <Color x:Key="Color.Raised">#1E3A57</Color>
    <Color x:Key="Color.Hover">#2A4A6B</Color>

    <!-- Thin, but not invisible: a hairline has to survive on both navies. -->
    <Color x:Key="Color.Hairline">#26415E</Color>

    <!-- Secondary text. Slate is a border/disabled value — far too dark to read on
         Navy — so muted copy sits between Slate and Silver. -->
    <Color x:Key="Color.Mute">#8FA1B6</Color>

    <!-- ─────────────── Semantic roles ─────────────── -->
    <!-- Chrome sits on the deeper navy so tabs and the page can float above it. -->
    <SolidColorBrush x:Key="Brush.Chrome"   Color="{StaticResource Color.NavyDeep}" />
    <!-- Navy is the signature surface: page canvas, active tab, new tab, splash. -->
    <SolidColorBrush x:Key="Brush.Canvas"   Color="{StaticResource Color.Navy}" />
    <SolidColorBrush x:Key="Brush.Surface"  Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Raised"   Color="{StaticResource Color.Raised}" />
    <SolidColorBrush x:Key="Brush.Hairline" Color="{StaticResource Color.Hairline}" />
    <SolidColorBrush x:Key="Brush.Slate"    Color="{StaticResource Color.Slate}" />

    <SolidColorBrush x:Key="Brush.Ink"    Color="{StaticResource Color.White}" />
    <SolidColorBrush x:Key="Brush.Body"   Color="{StaticResource Color.Silver}" />
    <SolidColorBrush x:Key="Brush.Mute"   Color="{StaticResource Color.Mute}" />

    <!-- Sky is the only accent. Used sparingly: focus, selection, active indication.
         It must never dominate the interface. -->
    <SolidColorBrush x:Key="Brush.Accent"  Color="{StaticResource Color.Sky}" />
    <SolidColorBrush x:Key="Brush.Selection" Color="{StaticResource Color.Sky}" Opacity="0.28" />

    <!-- ─────────────── Typography ───────────────
         Inter Tight for headings, Inter for body; both degrade to metric-similar
         system faces so nothing has to be shipped or downloaded. -->
    <FontFamily x:Key="Font.Display">Inter Tight, Inter, Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Sans">Inter, Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Mono">ui-monospace, Cascadia Mono, Consolas, monospace</FontFamily>

    <sys:Double x:Key="Font.Size.Display">28</sys:Double>
    <sys:Double x:Key="Font.Size.Title">20</sys:Double>
    <sys:Double x:Key="Font.Size.BodyLg">16</sys:Double>
    <sys:Double x:Key="Font.Size.Body">14</sys:Double>
    <sys:Double x:Key="Font.Size.Caption">12</sys:Double>

    <!-- Tracking is -1% of the size; WPF expresses it as a fraction of the em. -->
    <sys:Double x:Key="Font.Tracking">-0.01</sys:Double>

    <!-- ─────────────── Radius ───────────────
         Square. Edges are defined by value contrast and thin hairlines, never by a
         curve — the one exception is the app icon, whose 16% radius is fixed by the
         platform's icon mask rather than by this system. -->
    <CornerRadius x:Key="Radius.None">0</CornerRadius>

    <!-- ─────────────── Spacing ─────────────── -->
    <Thickness x:Key="Space.Xs">4</Thickness>
    <Thickness x:Key="Space.Sm">8</Thickness>
    <Thickness x:Key="Space.Md">12</Thickness>
    <Thickness x:Key="Space.Lg">20</Thickness>
    <Thickness x:Key="Space.Xl">32</Thickness>

    <Thickness x:Key="Pad.Button">18,9</Thickness>
    <Thickness x:Key="Pad.Omnibox">18,0</Thickness>

    <!-- ─────────────── Motion ───────────────
         "Animations should feel like gliding. Nothing snaps." -->
    <Duration x:Key="Motion.Fast">0:0:0.15</Duration>
    <Duration x:Key="Motion.Base">0:0:0.20</Duration>
    <Duration x:Key="Motion.Slow">0:0:0.25</Duration>

    <!-- Close approximation of the brand's cubic-bezier(.18,.89,.32,1): moves away
         quickly, settles softly, never overshoots. -->
    <PowerEase x:Key="Motion.Ease" Power="3" EasingMode="EaseOut" />

</ResourceDictionary>
