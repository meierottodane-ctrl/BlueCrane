<!--
    Control chrome. Every visual value resolves to a token from Tokens.xaml.

    The shapes are square: no rounded corners anywhere in the shell. Separation comes
    from value contrast and single-pixel hairlines. Colour changes glide rather than
    snap, and Sky is reserved for focus and active state — it never fills a surface.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:BlueCrane.Shell">

    <shell:Subtract x:Key="Subtract" />


    <!-- ─────────────── Icon button ───────────────
         Square hit target hosting a vector glyph; the fill glides in on hover. -->
    <Style x:Key="Style.IconButton" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Body}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd">
                        <Border.Background>
                            <SolidColorBrush Color="Transparent" />
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bd"
                                                        Storyboard.TargetProperty="Background.Color"
                                                        To="{StaticResource Color.Hover}"
                                                        Duration="{StaticResource Motion.Fast}"
                                                        EasingFunction="{StaticResource Motion.Ease}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bd"
                                                        Storyboard.TargetProperty="Background.Color"
                                                        To="Transparent"
                                                        Duration="{StaticResource Motion.Base}"
                                                        EasingFunction="{StaticResource Motion.Ease}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.28" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window caption buttons: wider and shorter, they meet the window edge. -->
    <Style x:Key="Style.CaptionButton" TargetType="Button" BasedOn="{StaticResource Style.IconButton}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Mute}" />
    </Style>

    <Style x:Key="Style.TabClose" TargetType="Button" BasedOn="{StaticResource Style.IconButton}">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Mute}" />
    </Style>

    <!-- ─────────────── Omnibox ───────────────
         The address bar is the full-width band it sits in, so the input itself carries
         no chrome of its own: no border, no fill, no radius. Large and quiet. -->
    <Style x:Key="Style.Omnibox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="SelectionOpacity" Value="0.28" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{StaticResource Pad.Omnibox}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.BodyLg}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The band behind the omnibox. Its hairline is the only focus cue the address
         bar needs — the whole rectangle acknowledges the caret. -->
    <Style x:Key="Style.AddressBand" TargetType="Border">
        <!-- Raised above the page so the address bar is unmistakably an input surface. -->
        <Setter Property="Background" Value="{StaticResource Brush.Raised}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource Color.Hairline}" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                            To="{StaticResource Color.Sky}"
                                            Duration="{StaticResource Motion.Base}"
                                            EasingFunction="{StaticResource Motion.Ease}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                            To="{StaticResource Color.Hairline}"
                                            Duration="{StaticResource Motion.Base}"
                                            EasingFunction="{StaticResource Motion.Ease}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ─────────────── Tab ───────────────
         Square blocks on the deeper navy; the active one lifts to the signature navy. -->
    <Style x:Key="Style.TabRoot" TargetType="Border">
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ─────────────── Scrollbar ───────────────
         Thin, monochrome, square, no arrows. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{StaticResource Brush.Slate}" Margin="2,0" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
